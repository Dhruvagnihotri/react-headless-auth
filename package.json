{
  "name": "@headlesskits/react-headless-auth",
  "version": "1.0.9",
  "description": "🔐 Production-ready React authentication in 2 minutes. Smart cookie fallback (httpOnly → localStorage), automatic token refresh, zero dependencies. Pairs with flask-headless-auth for 20+ backend routes. OAuth, JWT, TypeScript-first. Free Auth0/Clerk alternative.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./native": {
      "types": "./dist/adapters/native.d.ts",
      "import": "./dist/adapters/native.mjs",
      "require": "./dist/adapters/native.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {},
  "keywords": [
    "react",
    "authentication",
    "auth",
    "react-auth",
    "react-authentication",
    "headless-auth",
    "jwt",
    "jwt-auth",
    "oauth",
    "oauth2",
    "google-login",
    "microsoft-login",
    "flask",
    "flask-auth",
    "login",
    "signup",
    "register",
    "session",
    "session-management",
    "token",
    "access-token",
    "refresh-token",
    "secure-auth",
    "httponly-cookies",
    "nextjs",
    "nextjs-auth",
    "next-auth-alternative",
    "clerk-alternative",
    "supabase-auth-alternative",
    "typescript",
    "typescript-auth",
    "spa",
    "spa-authentication",
    "api-auth",
    "rest-api",
    "frontend-auth",
    "react-hooks",
    "context-api",
    "password-reset",
    "email-verification",
    "mfa",
    "two-factor",
    "rbac",
    "role-based-access",
    "security",
    "xss-protection",
    "csrf-protection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dhruvagnihotri/react-headless-auth"
  },
  "bugs": {
    "url": "https://github.com/Dhruvagnihotri/react-headless-auth/issues"
  },
  "homepage": "https://github.com/Dhruvagnihotri/react-headless-auth#readme",
  "author": {
    "name": "Dhruv Agnihotri",
    "email": "dagni@umich.edu",
    "url": "https://github.com/Dhruvagnihotri"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  }
}
